{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevmig"
		},
		"LS_Parent_Sqlserver_DW_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Parent_Sqlserver_DW'"
		},
		"LS_Parent_Sqlserver_DW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-BHT672CB\\SQLEXPRESS"
		},
		"LS_Parent_Sqlserver_DW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlmigration"
		},
		"LS_Parent_Sqlserver_DW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "LAPTOP-BHT672CB\\Vasanth"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevmig_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Parent_Sqlserver_DW_password": {
						"value": "[parameters('LS_Parent_Sqlserver_DW_password')]"
					},
					"LS_Parent_Sqlserver_DW_properties_typeProperties_server": {
						"value": "[parameters('LS_Parent_Sqlserver_DW_properties_typeProperties_server')]"
					},
					"LS_Parent_Sqlserver_DW_properties_typeProperties_database": {
						"value": "[parameters('LS_Parent_Sqlserver_DW_properties_typeProperties_database')]"
					},
					"LS_Parent_Sqlserver_DW_properties_typeProperties_userName": {
						"value": "[parameters('LS_Parent_Sqlserver_DW_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}